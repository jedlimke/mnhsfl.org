{
  "name": "MNHSFL Jekyll Site",
  "image": "mcr.microsoft.com/devcontainers/ruby:3.3",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    }
  },

  // Run bundle install once when the container is first created.
  // Force pure-Ruby platform to avoid native extension build failures (e.g. prism on aarch64).
  "postCreateCommand": "bundle config set --local force_ruby_platform true && bundle install",

  // Start the Jekyll server every time the container starts.
  "postStartCommand": "python3 _scripts/convert_fencing_results.py && bundle exec jekyll serve --host 0.0.0.0 --port 4000 --livereload --force_polling",

  // Forward Jekyll and LiveReload ports
  "forwardPorts": [4000, 35729],
  "portsAttributes": {
    "4000": {
      "label": "Jekyll Site",
      "onAutoForward": "notify"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "yzhang.markdown-all-in-one",
        "sissel.shopify-liquid",
        "shopify.ruby-lsp"
      ],
      "settings": {
        "python.analysis.extraPaths": ["_scripts"]
      }
    }
  }
}
